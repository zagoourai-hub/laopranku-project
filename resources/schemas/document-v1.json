{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidocs.local/schemas/document-v1.json",
  "title": "Document v1",
  "type": "object",
  "required": ["schema_version", "type", "cover", "style", "chapters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "type": { "enum": ["makalah", "laporan_praktikum", "laporan_pkl", "proposal"] },
    "cover": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "nim": { "type": "string" },
        "prodi": { "type": "string" },
        "campus": { "type": "string" },
        "year": { "type": "string" }
      }
    },
    "style": { "enum": ["formal", "semi_formal", "ringkas"] },
    "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1 },
          "url": { "type": ["string", "null"] },
          "doi": { "type": ["string", "null"] }
        }
      }
    },
    "brief": {
      "type": "object",
      "properties": {
        "topic": { "type": "string" },
        "chapter_count": { "type": "integer", "minimum": 3, "maximum": 7 },
        "length": { "enum": ["ringkas", "sedang", "panjang"] },
        "instructions": { "type": "string", "maxLength": 500 },
        "facts": { "type": ["object", "array"], "maxItems": 0 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "heading": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*(?:BAB\\b|\\d+(?:\\.\\d+)+\\.?\\s|\\d+[.)]\\s))"
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title", "sections"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/heading" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/heading" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "paragraph" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["id", "type", "ordered", "items"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "list" },
            "ordered": { "type": "boolean" },
            "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
